    "from pyspark.sql import functions as F\n",
    "\n",
    "def add_ingestion_metadata(input_df):\n",
    "  return (\n",
    "    input_df\n",
    "      .withColumn(\"ingestion_timestamp\", F.current_timestamp())\n",
    "      .withColumn(\"source_file\", F.col('_metadata.file_path')))"
   ]
  }
